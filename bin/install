install_elasticsearch() {
  local install_type=$1
  local version=$2
  local install_path=$3

  local tmp_download_dir
  tmp_download_dir=$(mktemp -d)

  local source_path
  source_path=$(get_download_file_path "$install_type" "$version" "$tmp_download_dir")
  download_source "$install_type" "$version" "$source_path"

  (
    cd "$(dirname "$source_path")"
    tar zxf "$source_path" || exit 1
    cd "$(untar_path "$install_type" "$version" "$tmp_download_dir")"

    find . -name "*.exe" -print0 | xargs -r0 rm
    find . -name "*.bat" -print0 | xargs -r0 rm

    mv ./* "$ASDF_INSTALL_PATH" || exit 1
  )
}

untar_path() {
  local install_type=$1
  local version=$2
  local tmp_download_dir=$3

  echo "$tmp_download_dir/elasticsearch-${version}"
}

download_source() {
  local install_type=$1
  local version=$2
  local download_path=$3
  local download_url
  download_url=$(get_download_url "$install_type" "$version")

  curl -SLfo "$download_path" "$download_url"
}

get_download_file_path() {
  local install_type=$1
  local version=$2
  local tmp_download_dir=$3

  echo "$tmp_download_dir/elasticsearch-${version}.tar.gz"
}

version_ge() {
  [ "$(printf '%s\n%s' "$1" "$2" | sort -V | head -1)" = "$2" ]
}

get_download_url() {
  local install_type=$1
  local version=$2
  local os
  local arch
  os=$(uname -s)
  arch=$(uname -m)

  if version_ge "$version" "7.0.0"; then
    if [[ "$os" == "Darwin" ]]; then
      if [[ "$arch" == "arm64" ]]; then
        echo "https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-$version-darwin-aarch64.tar.gz"
      else
        echo "https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-$version-darwin-x86_64.tar.gz"
      fi
    else
      if [[ "$arch" == "aarch64" ]]; then
        echo "https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-$version-linux-aarch64.tar.gz"
      else
        echo "https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-$version-linux-x86_64.tar.gz"
      fi
    fi
  elif version_ge "$version" "2.4.7"; then
    echo "https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-$version.tar.gz"
  else
    echo "https://download.elastic.co/elasticsearch/elasticsearch/elasticsearch-$version.tar.gz"
  fi
}

install_elasticsearch $ASDF_INSTALL_TYPE $ASDF_INSTALL_VERSION $ASDF_INSTALL_PATH